@using EWallet.BLL.Resources
@using EWallet.DAL.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<Messages> L

<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        var user = await UserManager.GetUserAsync(User);
        <li class="nav-item">
            <span class="nav-link text-dark">
                @L["AccountLabel"]: <b>@user?.AccountNumber</b> |
                @L["BalanceLabel"]: <b id="user-balance">@user?.Balance</b>
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Payment" asp-action="Index">@L["PaymentMenu"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Transfer" asp-action="Index">@L["TransferMenu"]</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="History" asp-action="Index">@L["HistoryMenu"]</a>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">@L["Logout"]</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Register">@L["Register"]</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">@L["Login"]</a></li>
    }
</ul>