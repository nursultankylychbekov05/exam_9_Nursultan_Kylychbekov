@model EWallet.Web.Models.TransferViewModel
@using EWallet.BLL.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Messages> L
@{ ViewData["Title"] = L["TransferTitle"].Value; }

<div class="col-md-4 mx-auto mt-4">
    <h2>@L["TransferTitle"]</h2>
    <form id="transfer-form" asp-controller="Transfer" asp-action="Index" method="post">
        <div class="mb-3">
            <label asp-for="RecipientAccount" class="form-label"></label>
            <input asp-for="RecipientAccount" class="form-control" maxlength="6" />
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" value="" />
        </div>
        <button type="submit" class="btn btn-primary">@L["Transfer"]</button>
    </form>
</div>

@section Scripts {
    <script>
        const form = document.getElementById('transfer-form');
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            submitAjax(form, function () { form.reset(); });
        });
    </script>
}