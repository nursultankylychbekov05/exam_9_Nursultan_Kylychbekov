@using EWallet.BLL.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Messages> L
@{ ViewData["Title"] = L["DepositTitle"].Value; }

<div class="col-md-4 mx-auto mt-4">
    <h2>@L["DepositTitle"]</h2>
    <form id="deposit-form" asp-controller="Wallet" asp-action="Deposit" method="post">
        <div class="mb-3">
            <label class="form-label" for="AccountNumber">@L["AccountNumber"]</label>
            <input class="form-control" id="AccountNumber" name="AccountNumber" maxlength="6" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="Amount">@L["Amount"]</label>
            <input class="form-control" id="Amount" name="Amount" type="number" min="0.01" step="0.01" />
        </div>
        <button type="submit" class="btn btn-primary">@L["Deposit"]</button>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('deposit-form').addEventListener('submit', function (e) {
            e.preventDefault();
            submitAjax(this, function () { this.reset(); }.bind(this));
        });
    </script>
}