@model EWallet.Web.Models.HistoryViewModel
@using EWallet.BLL.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Messages> L
@{ ViewData["Title"] = L["HistoryTitle"].Value; }

<h2>@L["HistoryTitle"]</h2>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label" for="from">@L["DateFrom"]</label>
        <input type="date" class="form-control" id="from" name="from"
               value="@Model.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label" for="to">@L["DateTo"]</label>
        <input type="date" class="form-control" id="to" name="to"
               value="@Model.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-primary">@L["Filter"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["Reset"]</a>
    </div>
</form>

@if (!Model.Items.Any())
{
    <p class="text-muted">@L["NoTransactions"]</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>@L["ColDate"]</th>
            <th>@L["ColType"]</th>
            <th class="text-end">@L["ColAmount"]</th>
            <th>@L["ColCounterparty"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@item.Type</td>
                <td class="text-end @(item.Amount >= 0 ? "text-success" : "text-danger")">
                    @(item.Amount >= 0 ? "+" : "")@item.Amount.ToString("N2")
                </td>
                <td>@item.Counterparty</td>
            </tr>
        }
        </tbody>
    </table>
}